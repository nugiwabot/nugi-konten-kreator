# Local Embedding Server (LM Studio / OpenAI Compatible)
EMBEDDING_URL=http://localhost:1234/v1/embeddings
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_TIMEOUT=10

# Local Reranker Server (BGE-Reranker-v2-m3 / TEI Compatible)
RERANKER_URL=http://127.0.0.1:8080/v1/rerank
RERANKER_TIMEOUT=10

# Directory containing local PDF books (Kept offline on local machine)
PDF_DIR=C:\Users\Nugi\Downloads

# Vector store destination
KNOWLEDGE_STORE_PATH=engine/data/knowledge_store.json

# Web research search result limits
WEB_SEARCH_MAX_RESULTS=5
