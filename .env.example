# ==============================================================================
# NUGI CONTENT INTELLIGENCE & INFLUENCE ENGINE
# Environment Configuration Template
# ==============================================================================

# Local Embedding Server (LM Studio / OpenAI Compatible)
EMBEDDING_URL=http://localhost:1234/v1/embeddings
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_TIMEOUT=10

# Local Reranker Server (BGE-Reranker-v2-m3 / TEI Compatible)
RERANKER_URL=http://127.0.0.1:8080/v1/rerank
RERANKER_TIMEOUT=10

# Directory containing local PDF books (Kept offline on local machine)
PDF_DIR=C:\Users\Nugi\Downloads

# Vector store destination
KNOWLEDGE_STORE_PATH=engine/data/knowledge_store.json

# Web research search result limits
WEB_SEARCH_MAX_RESULTS=5

# ==============================================================================
# MEDIA RETRIEVAL AGENT CONFIGURATION
# ==============================================================================

# Download destination (relative to project root or absolute path)
MEDIA_ASSETS_DIR=assets/media

# Max candidates to retrieve per provider search query
MEDIA_SEARCH_MAX_RESULTS=20

# HTTP timeout for file downloads (seconds)
MEDIA_DOWNLOAD_TIMEOUT=60

# Maximum file size allowed for download (MB). Files larger than this are skipped.
MEDIA_MAX_FILE_SIZE_MB=500

# Wikimedia Commons API endpoint (no API key needed)
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php

# Internet Archive base URL (no API key needed)
INTERNET_ARCHIVE_API_URL=https://archive.org
