# ==============================================================================
# NUGI CONTENT CREATOR — EDITORIAL INTELLIGENCE ENGINE v2
# Environment Configuration
# ==============================================================================

# Local / LAN Embedding Server (LM Studio / OpenAI Compatible)
EMBEDDING_URL=http://192.168.0.114:1234/v1/embeddings
EMBEDDING_MODEL=Qwen3-Embedding-4B-Q4_K_M.gguf
EMBEDDING_TIMEOUT=10
EMBEDDING_REQUIRED=true

# Local / LAN Reranker Server (BGE-Reranker-v2-m3 / TEI Compatible)
RERANKER_URL=http://192.168.0.114:8080/v1/rerank
RERANKER_TIMEOUT=10
RERANKER_REQUIRED=true

# Fallback Safety Policy (false = fail-fast in production to prevent silent low-quality retrieval)
ALLOW_FALLBACK=false

# Directory containing local PDF books (Portable relative path or absolute path)
PDF_DIR=./data/books

# Vector store destination
KNOWLEDGE_STORE_PATH=engine/data/knowledge_store.json

# Web research search result limits
WEB_SEARCH_MAX_RESULTS=6

# ==============================================================================
# MEDIA RETRIEVAL AGENT CONFIGURATION
# ==============================================================================

# Download destination (relative to project root or absolute path)
MEDIA_ASSETS_DIR=assets/media

# Max candidates to retrieve per provider search query
MEDIA_SEARCH_MAX_RESULTS=20

# HTTP timeout for file downloads (seconds)
MEDIA_DOWNLOAD_TIMEOUT=60

# Maximum file size allowed for download (MB)
MEDIA_MAX_FILE_SIZE_MB=500

# Wikimedia Commons API endpoint
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php

# Internet Archive base URL
INTERNET_ARCHIVE_API_URL=https://archive.org

# Optional RSS/Atom discovery. RSSHub is self-hosted/optional; a public
# instance is never required. Feed items are discovery leads, not evidence.
RSS_DISCOVERY_ENABLED=true
RSS_FEED_REGISTRY_PATH=engine/data/feed_registry.json
RSSHUB_BASE_URL=
RSSHUB_FALLBACK_URL=
RSS_CACHE_TTL_SECONDS=900
RSS_FETCH_TIMEOUT_SECONDS=8
RSS_MAX_FEED_BYTES=2097152
RSS_MAX_SOURCES_PER_QUERY=5

# Only assets with one of these explicit per-item rights statuses can be
# auto-downloaded. Unknown, editorial-only, and restricted results stay leads.
MEDIA_REUSABLE_LICENSES=PUBLIC_DOMAIN,CC0,CC_BY,CC_BY_SA,COMMERCIAL_ALLOWED,FREE_WITH_ATTRIBUTION
