# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp

# Node / Dependency directories
node_modules/
dist/
build/

# Python & Testing
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Large binaries, books & generated local vector data
*.pdf
*.epub
engine/data/*.json
!engine/data/.gitkeep

# AI Workspace Lock — machine-local state & ACL backups
.ai-guard/backups/*/
.ai-guard/lock.state

# Temporary processing & scratch workspace (never push to GitHub)
.temp_broll/
.temp/
output/.broll_query_cache.json
output/.question_mining_cache.json
output/*.jpg
output/*.jpeg
output/*.png
output/*.mp4
output/*.mov
output/*.mkv
output/*.webm
output/*.webp
output/*/*.jpg
output/*/*.jpeg
output/*/*.png
output/*/*.mp4
output/*/*.webp

# Workspace media assets (keep .gitkeep, ignore all footage, broll, and renders)
output/*-script/**/*.mp4
output/*-script/**/*.mov
output/*-script/**/*.mkv
output/*-script/**/*.webm
output/*-script/**/*.wav
output/*-script/**/*.mp3
output/*-script/**/*.jpg
output/*-script/**/*.jpeg
output/*-script/**/*.png
output/*-script/**/*.webp
!output/*-script/**/.gitkeep

# Local sound effects assets
assets/sound_effects/*.wav
assets/sound_effects/*.mp3
!assets/sound_effects/.gitkeep

